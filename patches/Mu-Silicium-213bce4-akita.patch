+//
+// Copyright (c) 2011 - 2025, Arm Limited. All rights reserved.
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+//
+
+#include <AsmMacroLib.h>
+
+#include <Library/ArmLib.h>
+
+//
+// SCTRL_EL1 Bits
+//
+.set CTRL_SPAN_BIT, BIT23
+
+ASM_FUNC (_ModuleEntryPoint)
+  // Keep the Boot Loader's x0 (the Device Tree on Android Boot Loaders) and
+  // BootShim's x1 (where the Firmware Volume sits in the loaded Kernel Image)
+  mov   x19, x0
+  mov   x20, x1
+
+  // Do Platform Specific Initialization
+  bl    ASM_PFX (PlatformAssemblyInitialize)
+
+  // Disable SPAN
+  EL1_OR_EL2 (x0)
+1:mrs   x0, sctlr_el1
+  orr   x0, x0, #CTRL_SPAN_BIT
+  msr   sctlr_el1, x0
+2:nop
+
+  // Enable Floating Point
+  bl    ASM_PFX (ArmEnableVFP)
+
+  // Setup Exception Vector
+  EL1_OR_EL2 (x0)
+1:bl    ASM_PFX (SetupExceptionLevel1)
+  b     ASM_PFX (MainEntryPoint)
+2:bl    ASM_PFX (SetupExceptionLevel2)
+  b     ASM_PFX (MainEntryPoint)
+
+ASM_PFX (MainEntryPoint):
+  // Get Stack Details
+  MOV64 (x0, FixedPcdGet64 (PcdCPUCoresStackBase))
+  MOV32 (x1, FixedPcdGet32 (PcdCPUCorePrimaryStackSize))
+
+  // Set Stack End Address
+  add   x2, x0, x1
+
+  // Set Stack Pointer
+  mov   sp, x2
+
+  // Clear Stack
+  mov   x3, xzr
+0:stp   x3, x3, [x0], #16
+  cmp   x0, x2
+  b.lt  0b
+
+  // Set Jump Location
+  ldr   x9, =ASM_PFX (SecEntry)
+
+  // Pass the Boot Loader's x0 and BootShim's x1
+  mov   x0, x19
+  mov   x1, x20
+
+  // Clear Frame Pointer
+  mov   x29, xzr
+
+  // Jump to C Code
+  blr   x9
+
+  // Do Infinite Spin
+  b     .
