+#include <Library/PcdLib.h>
+#include <Library/DebugLib.h>
+#include <Library/PrePiLib.h>
+#include <Library/DebugAgentLib.h>
+#include <Library/BaseMemoryLib.h>
+#include <Library/SerialPortLib.h>
+#include <Library/PlatformSecLib.h>
+#include <Library/PrePiHobListPointerLib.h>
+#include <Library/CacheMaintenanceLib.h>
+#include <Library/MemoryMapHelperLib.h>
+#include <Library/TimerLib.h>
+#include <Library/HobLib.h>
+#include <Library/FdtLib.h>
+
+#include "Sec.h"
+
+//
+// Entry Argument HOB: the x0 Value the Boot Loader passed (the Device Tree on
+// Android Boot Loaders) as a UINT64. UniXNURamDiskDxe reads the initrd from it.
+//
+STATIC CONST EFI_GUID mEntryArgHobGuid = {
+  0xDAEE82E6, 0x8090, 0x4E72, { 0xBF, 0xB9, 0x78, 0xC1, 0x3C, 0xD4, 0xE3, 0x59 }
+};
+
+//
+// Kernel Image Payload HOB: the Address right behind the Firmware Volume in the
+// Kernel Image the Boot Loader loaded, as a UINT64. A UniXNU Payload appended
+// to the Kernel Field is found there when the Boot Loader drops the Boot Image
+// Ramdisk (Android 13+ Devices with init_boot).
+//
+STATIC CONST EFI_GUID mKernelPayloadHobGuid = {
+  0xED7FAD14, 0x5950, 0x4B58, { 0xBE, 0xB8, 0x0F, 0xF4, 0x4D, 0x11, 0xF5, 0xA8 }
+};
+
+#ifndef MDEPKG_NDEBUG
+STATIC
+VOID
+ClearFrameBuffer (VOID)
+{
+  EFI_MEMORY_REGION_DESCRIPTOR FrameBufferRegion;
+
+  // Locate "Display Reserved" Memory Region
+  LocateMemoryRegionByName ("Display Reserved", &FrameBufferRegion);
+  LocateMemoryRegionByName ("Display_Reserved", &FrameBufferRegion);
+
+  // Clear Memory Region
+  if (FrameBufferRegion.Address != 0 && FrameBufferRegion.Length != 0) {
+    ZeroMem ((VOID *)FrameBufferRegion.Address, FrameBufferRegion.Length);
+  }
+}
+
+STATIC
+VOID
+PrintFirmwareVersion (VOID)
+{
+  // Clear Frame Buffer
+  ClearFrameBuffer ();
+
+  // Print UEFI Version Message
+  DEBUG ((EFI_D_WARN, "\n"));
+  DEBUG ((EFI_D_WARN, "Project Silicium for %a %a\n",            FixedPcdGetPtr (PcdSmbiosSystemManufacturer), FixedPcdGetPtr (PcdSmbiosSystemModel)));
+  DEBUG ((EFI_D_WARN, "Firmware Version %s Build at %a on %a\n", PcdGetPtr (PcdFirmwareVersionString), __TIME__, __DATE__));
+  DEBUG ((EFI_D_WARN, "\n"));
+}
+#endif
+
+STATIC
+EFI_STATUS
+InitializeMemory (VOID)
+{
+  EFI_STATUS                    Status;
+  EFI_MEMORY_REGION_DESCRIPTOR  UefiMemoryRegion;
+  EFI_HOB_HANDOFF_INFO_TABLE   *HobList;
+
+  // Locate "DXE Heap" Memory Region
+  LocateMemoryRegionByName ("DXE Heap", &UefiMemoryRegion);
+  LocateMemoryRegionByName ("DXE_Heap", &UefiMemoryRegion);
+
+  // Save UEFI Memory Details
+  UINTN UefiMemoryBase = UefiMemoryRegion.Address;
+  UINTN UefiMemorySize = UefiMemoryRegion.Length;
+
+  // Verify UEFI Memory Base
+  if (UefiMemoryBase == 0 && UefiMemorySize == 0) {
+    DEBUG ((EFI_D_ERROR, "Failed to Locate \"DXE Heap\" Memory Region!\n"));
+    return EFI_NOT_FOUND;
+  }
+
+  // Initialize HOB List
+  HobList = HobConstructor ((VOID *)UefiMemoryBase, UefiMemorySize, (VOID *)UefiMemoryBase, (VOID *)(UefiMemoryBase + UefiMemorySize));
+  PrePeiSetHobList (HobList);
+
+  // Initialize MMU & Memory HOBs
+  Status = MemoryPeim (UefiMemoryBase, UefiMemorySize);
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  // Build Stack HOB
+  BuildStackHob (FixedPcdGet64 (PcdCPUCoresStackBase), FixedPcdGet32 (PcdCPUCorePrimaryStackSize));
+
+  return EFI_SUCCESS;
+}
+
+//
+// The Device Tree and the initrd the Boot Loader handed over. They are read
+// while the MMU is still off, because the Boot Loader places them in DRAM the
+// Memory Map does not list (the Device Tree is at 0x8A000000 on akita); the
+// RAM Manager maps that DRAM later, and UniXNURamDiskDxe claims the initrd.
+//
+STATIC UINT64 mHandoffFdtStart;
+STATIC UINT64 mHandoffFdtEnd;
+STATIC UINT64 mHandoffInitrdStart;
+STATIC UINT64 mHandoffInitrdEnd;
+
+STATIC
+VOID
+ReadBootLoaderHandoff (
+  IN UINT64 EntryArgument)
+{
+  CONST VOID *Fdt = (CONST VOID *)(UINTN)EntryArgument;
+  CONST VOID *StartProp;
+  CONST VOID *EndProp;
+  INT32       Chosen;
+  INT32       StartLength;
+  INT32       EndLength;
+
+  if (EntryArgument == 0 || (EntryArgument & 3) != 0 || FdtCheckHeader (Fdt) != 0) {
+    DEBUG ((EFI_D_WARN, "Boot Loader x0 0x%llx is not a Device Tree\n", EntryArgument));
+    return;
+  }
+
+  mHandoffFdtStart = EntryArgument;
+  mHandoffFdtEnd   = EntryArgument + FdtTotalSize (Fdt);
+
+  Chosen = FdtPathOffset (Fdt, "/chosen");
+  if (Chosen >= 0) {
+    StartProp = FdtGetProp (Fdt, Chosen, "linux,initrd-start", &StartLength);
+    EndProp   = FdtGetProp (Fdt, Chosen, "linux,initrd-end",   &EndLength);
+    if (StartProp != NULL && EndProp != NULL) {
+      mHandoffInitrdStart = (StartLength == 8) ? Fdt64ToCpu (ReadUnaligned64 (StartProp)) : Fdt32ToCpu (ReadUnaligned32 (StartProp));
+      mHandoffInitrdEnd   = (EndLength   == 8) ? Fdt64ToCpu (ReadUnaligned64 (EndProp))   : Fdt32ToCpu (ReadUnaligned32 (EndProp));
+    }
+  }
+
+  DEBUG ((EFI_D_WARN, "Boot Loader Device Tree 0x%llx-0x%llx, initrd 0x%llx-0x%llx\n", mHandoffFdtStart, mHandoffFdtEnd, mHandoffInitrdStart, mHandoffInitrdEnd));
+}
+
+STATIC
+VOID
+SecMain (
+  IN UINT64 EntryArgument,
+  IN UINT64 ImageFdAddress)
+{
+  EFI_STATUS Status;
+
+  // Do Platform Specific Initialization
+  PlatformInitialize ();
+
+#ifndef MDEPKG_NDEBUG
+  // Initialize Serial Port
+  Status = SerialPortInitialize ();
+  if (EFI_ERROR (Status)) {
+    return;
+  }
+
+  // Print Firmware Version
+  PrintFirmwareVersion ();
+
+  // Initialize Debug Agent
+  InitializeDebugAgent (DEBUG_AGENT_INIT_POSTMEM_SEC, NULL, NULL);
+  SaveAndSetDebugTimerInterrupt (TRUE);
+#endif
+
+  // Read the Boot Loader Handoff while the MMU is off
+  ReadBootLoaderHandoff (EntryArgument);
+
+  // Initialize Memory
+  Status = InitializeMemory ();
+  if (EFI_ERROR (Status)) {
+    return;
+  }
+
+  // Build Entry Argument HOB
+  BuildGuidDataHob (&mEntryArgHobGuid, &EntryArgument, sizeof (EntryArgument));
+
+  // Build Kernel Image Payload HOB
+  if (ImageFdAddress != 0 && ImageFdAddress != FixedPcdGet64 (PcdFdBaseAddress)) {
+    UINT64 PayloadAddress = ImageFdAddress + FixedPcdGet32 (PcdFdSize);
+
+    BuildGuidDataHob (&mKernelPayloadHobGuid, &PayloadAddress, sizeof (PayloadAddress));
+    DEBUG ((EFI_D_WARN, "Kernel Image Payload at 0x%llx\n", PayloadAddress));
+  }
+
+
+  // Build CPU HOB
+  BuildCpuHob (ArmGetPhysicalAddressBits (), PcdGet8 (PcdPrePiCpuIoSize));
+
+  // Set the Boot Mode
+  SetBootMode (BOOT_WITH_DEFAULT_SETTINGS);
+
+  // Initialize Platform HOBs
+  Status = PlatformPeim ();
+  if (EFI_ERROR (Status)) {
+    return;
+  }
+
+  // Run Library Cconstructors
+  ProcessLibraryConstructorList ();
+
+  // Decompress all FVs
+  Status = DecompressFirstFv ();
+  if (EFI_ERROR (Status)) {
+    DEBUG ((EFI_D_ERROR, "Failed to Decompress FV! Status = %r\n", Status));
+    return;
+  }
+
+  // Load DXE Core
+  Status = LoadDxeCoreFromFv (NULL, 0);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((EFI_D_ERROR, "Failed to Load DXE Core! Status = %r\n", Status));
+  }
+}
+
+VOID
+SecEntry (
+  IN UINT64 EntryArgument,
+  IN UINT64 ImageFdAddress)
+{
+  // Disable Data Cache
+  ArmDisableDataCache ();
+
+  // Invalidate Instruction Cache
+  ArmInvalidateInstructionCache ();
+
+  // Enable Instruction Cache
+  ArmEnableInstructionCache ();
+
+  // Invalidate Stack & UEFI FD D-Cache
+  InvalidateDataCacheRange ((VOID *)FixedPcdGet64 (PcdCPUCoresStackBase), FixedPcdGet32 (PcdCPUCorePrimaryStackSize));
+  InvalidateDataCacheRange ((VOID *)FixedPcdGet64 (PcdFdBaseAddress),     FixedPcdGet32 (PcdFdSize));
+
+  // Verify Exception Vector Table
+  ASSERT (((UINTN)SecVectorTable & ARM_VECTOR_TABLE_ALIGNMENT) == 0);
+
+  // Enable new Exception Vector Table
+  ArmWriteVBar ((UINTN)SecVectorTable);
+
+  // Enter Main SEC Function
+  SecMain (EntryArgument, ImageFdAddress);
+}
