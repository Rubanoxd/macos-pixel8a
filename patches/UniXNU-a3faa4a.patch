+STATIC
+BOOLEAN
+IsFatBootSector (
+  IN  CONST UINT8  *Sector,
+  IN  UINT64       Available,
+  OUT UINT64       *VolumeBytes
+  )
+{
+  UINT16  BytesPerSector;
+  UINT64  Sectors;
+
+  if ((Sector[510] != 0x55) || (Sector[511] != 0xAA) || ((Sector[0] != 0xEB) && (Sector[0] != 0xE9))) {
+    return FALSE;
+  }
+
+  BytesPerSector = (UINT16)(Sector[11] | (Sector[12] << 8));
+  Sectors        = (UINT64)(Sector[19] | (Sector[20] << 8));
+  if (Sectors == 0) {
+    Sectors = (UINT64)Sector[32] | ((UINT64)Sector[33] << 8) | ((UINT64)Sector[34] << 16) | ((UINT64)Sector[35] << 24);
+  }
+
+  if ((BytesPerSector != RAM_BLOCK_SIZE) || (Sector[13] == 0) || (Sector[16] == 0) || (Sectors == 0) ||
+      (Sectors * RAM_BLOCK_SIZE > Available))
+  {
+    return FALSE;
+  }
+
+  *VolumeBytes = Sectors * RAM_BLOCK_SIZE;
+  return TRUE;
+}
+
+/**
+  Narrow [*Start, *End) to the first FAT volume in it, scanning sector by sector.
+**/
+STATIC
+BOOLEAN
+FindFatVolume (
+  IN OUT UINT64  *Start,
+  IN OUT UINT64  *End
+  )
+{
+  UINT64  Offset;
+  UINT64  Bytes;
+
+  for (Offset = *Start; Offset + RAM_BLOCK_SIZE <= *End; Offset += RAM_BLOCK_SIZE) {
+    if (IsFatBootSector ((CONST UINT8 *)(UINTN)Offset, *End - Offset, &Bytes)) {
+      *Start = Offset;
+      *End   = Offset + Bytes;
+      return TRUE;
+    }
+  }
+
+  return FALSE;
+}
+
+STATIC
+BOOLEAN
+PublishVolume (
+  IN UINT64  Start,
+  IN UINT64  End
+  )
+{
+  EFI_STATUS  Status;
+  EFI_HANDLE  Handle;
+
+  DEBUG ((DEBUG_ERROR, "UNIXNURAMDISK: FAT volume 0x%lx-0x%lx\n", Start, End));
+
+  //
+  // Claim the initrd pages: on Mu-Silicium ports whose RAM manager publishes
+  // the DRAM as conventional memory, nothing else keeps them out of the
+  // allocator while the payload is in use.
+  //
+  {
+    EFI_PHYSICAL_ADDRESS  Claim = Start & ~(EFI_PHYSICAL_ADDRESS)EFI_PAGE_MASK;
+
+    Status = gBS->AllocatePages (AllocateAddress, EfiBootServicesData, EFI_SIZE_TO_PAGES (End - Claim), &Claim);
+    DEBUG ((DEBUG_ERROR, "UNIXNURAMDISK: claim initrd pages %r\n", Status));
+  }
+
+  mRamBase                = (UINT8 *)(UINTN)Start;
+  mMedia.MediaId          = 1;
+  mMedia.RemovableMedia   = FALSE;
+  mMedia.MediaPresent     = TRUE;
+  mMedia.LogicalPartition = FALSE;
+  mMedia.ReadOnly         = TRUE;
+  mMedia.WriteCaching     = FALSE;
+  mMedia.BlockSize        = RAM_BLOCK_SIZE;
+  mMedia.IoAlign          = 1;
+  mMedia.LastBlock        = (End - Start) / RAM_BLOCK_SIZE - 1;
+
+  Handle = NULL;
+  Status = gBS->InstallMultipleProtocolInterfaces (
+                  &Handle,
+                  &gEfiDevicePathProtocolGuid,
+                  &mDevicePath,
+                  &gEfiBlockIoProtocolGuid,
+                  &mBlockIo,
+                  NULL
+                  );
+  DEBUG ((DEBUG_ERROR, "UNIXNURAMDISK: initrd block device 0x%lx size 0x%lx %r\n", Start, End - Start, Status));
+  return !EFI_ERROR (Status);
+}
