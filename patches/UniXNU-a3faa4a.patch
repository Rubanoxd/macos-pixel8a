+# UNIXNU_PROBE_RESET_PREP_SMC="fid,x1,x2,x3" issues one SMC before each PSCI reset, e.g. to set
+# the reboot mode a board's bootloader reads (akita: Tensor PMU write of 0xfc = bootloader).
+_PREP = os.environ.get('UNIXNU_PROBE_RESET_PREP_SMC', '')
+def _mov32(reg, value):
+    # movz/movk keep the code small (the caves are tight); values are 32-bit at most.
+    if value < 0x10000:
+        return f'  mov x{reg}, #{value:#x}\n'
+    return f'  movz w{reg}, #{value & 0xffff:#x}\n  movk w{reg}, #{value >> 16:#x}, lsl #16\n'
