+/**
+  Android 13+ bootloaders with an init_boot partition drop the boot image
+  ramdisk; a payload appended to the kernel field after the firmware volume
+  is loaded with the kernel instead.
+**/
+STATIC
+VOID
+PublishKernelPayload (
+  VOID
+  )
+{
+  EFI_HOB_GUID_TYPE  *Hob;
+  UINT64             Start;
+  UINT64             Bytes;
+
+  Hob = GetFirstGuidHob (&mKernelPayloadHobGuid);
+  if ((Hob == NULL) || (GET_GUID_HOB_DATA_SIZE (Hob) < sizeof (UINT64))) {
+    DEBUG ((DEBUG_ERROR, "UNIXNURAMDISK: no kernel image payload HOB\n"));
+    return;
+  }
+
+  Start = ReadUnaligned64 ((CONST UINT64 *)GET_GUID_HOB_DATA (Hob));
+  if (!IsFatBootSector ((CONST UINT8 *)(UINTN)Start, KERNEL_PAYLOAD_MAX, &Bytes)) {
+    DEBUG ((DEBUG_ERROR, "UNIXNURAMDISK: no FAT volume behind the firmware at 0x%lx\n", Start));
+    return;
+  }
+
+  DEBUG ((DEBUG_ERROR, "UNIXNURAMDISK: kernel image payload 0x%lx-0x%lx\n", Start, Start + Bytes));
+  PublishVolume (Start, Start + Bytes);
