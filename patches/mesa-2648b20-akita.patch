+/* The color attachments a draw writes: those its fragment shader writes, less the
+ * ones its blend state masks off (colorWriteMask 0, or color writes disabled).
+ * A masked-off attachment written by the shader is claimed in the draw's render
+ * target mask (DCD flags 1, 2) and so counts as written to the hardware's tile
+ * tracking though its blend descriptor is OFF: a tile the draw fully covers then
+ * left that attachment's tile buffer as it was before the draw, which for a
+ * preload that skips such tiles is unloaded memory (zero): the tile stores out black. */
+static inline uint32_t
+color_attachment_effective_written_mask(
+   const struct panvk_shader_variant *fs,
+   const struct vk_dynamic_graphics_state *dyns)
+{
+   uint32_t mask = color_attachment_written_mask(fs, &dyns->cal);
+   const struct vk_color_blend_state *cb = &dyns->cb;
