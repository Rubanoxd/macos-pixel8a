+static unsigned
+akita_cmdbuf_take_tls(struct panvk_device *dev, struct panvk_cmd_buffer *cmdbuf, struct list_head *into)
+{
+   unsigned n = list_length(&cmdbuf->tls_pool.big_bos);
+   list_splicetail(&cmdbuf->tls_pool.big_bos, into);
+   list_inithead(&cmdbuf->tls_pool.big_bos);
+   n += akita_tls_fill(dev, cmdbuf, into);
+   util_dynarray_foreach(&cmdbuf->akita_secondaries, struct panvk_cmd_buffer *, sec) {
+      n += list_length(&(*sec)->tls_pool.big_bos);
+      list_splicetail(&(*sec)->tls_pool.big_bos, into);
+      list_inithead(&(*sec)->tls_pool.big_bos);
+      n += akita_tls_fill(dev, *sec, into);
+   }
+   return n;
+}
