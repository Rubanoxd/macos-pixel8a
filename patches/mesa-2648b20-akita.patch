+   list_splicetail(bos, &cache->free_bos);
+   list_inithead(bos);
+   unsigned count = list_length(&cache->free_bos);
+   while (count > cache->keep) {
+      struct panvk_priv_bo *smallest = NULL;
+      list_for_each_entry(struct panvk_priv_bo, bo, &cache->free_bos, node) {
+         if (!smallest || pan_kmod_bo_size(bo->bo) < pan_kmod_bo_size(smallest->bo))
+            smallest = bo;
+      }
+      list_del(&smallest->node);
+      panvk_priv_bo_unref(smallest);
+      count--;
