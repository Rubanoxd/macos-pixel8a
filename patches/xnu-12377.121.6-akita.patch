+	sheng_log_status("panel parameters enter");
+	const Boot_Video *v = &args->Video;
+	const uint64_t stride = v->v_rowBytes;
+	const unsigned scale = v->v_width >= 1600 ? 2 : 1;
+	const unsigned top = v->v_height >= 1024 ? 640 : 32;
+	const uint64_t available_columns = v->v_width > 32 ? (v->v_width - 32) / (8 * scale) : 0;
