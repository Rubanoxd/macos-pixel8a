+/* Register bring-up from the shell (the U-Boot md/mw equivalent): set kern.akita_phys_addr, then read
+ * kern.akita_phys_val or write kern.akita_phys_wr. A read of an unpowered block can hang the bus. */
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+static uint64_t akita_phys_addr;
+SYSCTL_QUAD(_kern, OID_AUTO, akita_phys_addr, CTLFLAG_RW | CTLFLAG_LOCKED, &akita_phys_addr,
+    "akita: physical address used by akita_phys_val / akita_phys_wr");
