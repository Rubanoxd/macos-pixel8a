+/* Mappings are kept for the life of the kernel (ml_io_unmap of an io_map range is not safe here). */
+static uint64_t akita_phys_pages[16];
+static vm_offset_t akita_phys_vas[16];
+
+static volatile uint32_t *
+akita_phys_map(void)
+{
+	uint64_t pa = akita_phys_addr & ~3ULL;
+	uint64_t page = pa & ~0x3fffULL;
+	if (pa == 0) {
+		return NULL;
+	}
+	unsigned slot;
+	for (slot = 0; slot < 16 && akita_phys_vas[slot] != 0; slot++) {
+		if (akita_phys_pages[slot] == page) {
+			return (volatile uint32_t *)(akita_phys_vas[slot] + (pa & 0x3fffULL));
+		}
+	}
+	if (slot == 16) {
+		return NULL;
+	}
+	akita_phys_vas[slot] = ml_io_map((vm_offset_t)page, 0x4000);
+	akita_phys_pages[slot] = page;
+	printf("AKITA PHYS: mapped 0x%llx at 0x%lx (slot %u)\n", page, (unsigned long)akita_phys_vas[slot], slot);
+	return (volatile uint32_t *)(akita_phys_vas[slot] + (pa & 0x3fffULL));
+}
