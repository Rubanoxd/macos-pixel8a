+	cmp x1, x0
+	b.lo 9f
+	lsr x2, x1, #47
+	cbnz x2, 9f
+	and x0, x0, #0xfffffffffe000000
+	and x1, x1, #0xfffffffffe000000
+	lsr x2, x0, #36
+	lsr x3, x1, #36
+	cmp x2, x3
+	b.ne 9f
+	add x2, x25, x2, lsl #3
+	ldr x3, [x2]
+	cbnz x3, 2f
+	SHENG_EARLY_ADDRESS x4, EXT(sheng_bootstrap_fb_l2)
+	mov x5, x4
+	mov x6, #2048
