+static kmod_info_t *
+sheng_native_crypto_descriptor(void)
+{
+	if (sheng_native_crypto_kmod) return sheng_native_crypto_kmod;
+	kernel_section_t *section = getsectbynamefromheader(
+		&_mh_execute_header, "__PRELINK_INFO", "__crypto_early");
+	if (!section) return NULL;
+	kernel_segment_command_t *data = getsegbynamefromheader(
+		&_mh_execute_header, "__PRELINK_DATA");
+	uintptr_t address;
+	if (!data || section->size != sizeof(uintptr_t) || vm_kernel_slide != 0) {
+		panic("SHENG: unsupported original corecrypto bootstrap layout");
+	}
+	__builtin_memcpy(&address, (const void *)section->addr, sizeof(address));
+	if (address < data->vmaddr || address - data->vmaddr > data->vmsize ||
+	    sizeof(kmod_info_t) > data->vmsize - (address - data->vmaddr)) {
+		panic("SHENG: original corecrypto descriptor outside prelink data");
+	}
+	kmod_info_t *module = (kmod_info_t *)address;
+	if (__builtin_memcmp(module->name, "com.apple.kec.corecrypto", sizeof("com.apple.kec.corecrypto")) != 0) {
+		panic("SHENG: original corecrypto descriptor identity mismatch");
+	}
+	sheng_native_crypto_kmod = module;
+	return module;
+}
+
+bool
+sheng_native_crypto_is_original(kmod_info_t *module)
+{
+	return module && module == sheng_native_crypto_descriptor();
+}
+
+kern_return_t
+sheng_native_crypto_start_once(kmod_info_t *module, void *data)
+{
+	if (!sheng_native_crypto_is_original(module)) {
+		panic("SHENG: unexpected original corecrypto descriptor");
+	}
+	unsigned expected = 0;
+	if (!__atomic_compare_exchange_n(&sheng_native_crypto_state, &expected, 1,
+	    false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+		if (expected == 1) panic("SHENG: recursive original corecrypto initialization");
+		return sheng_corecrypto_status;
+	}
+	printf("SHENG: original corecrypto start enter\n");
+	sheng_corecrypto_status = module->start(module, data);
+	__atomic_store_n(&sheng_native_crypto_state, sheng_corecrypto_status == KERN_SUCCESS ? 2 : 3,
+	    __ATOMIC_RELEASE);
+	return sheng_corecrypto_status;
+}
+
+static void
+sheng_corecrypto_bootstrap(void)
+{
+	static kmod_info_t info = {
+		.info_version = KMOD_INFO_VERSION,
+		.name = "sheng-source-corecrypto",
+		.version = "26.0",
+	};
+	uint32_t mode = 0;
+
+	/* Keep the provider's full default POST during bootstrap. */
+	if (PE_parse_boot_argn("fips_mode", &mode, sizeof(mode)) && mode != 0) {
+		panic("SHENG source corecrypto requires complete default POST");
+	}
+	kmod_info_t *original = sheng_native_crypto_descriptor();
+	if (original) {
+		sheng_corecrypto_status = sheng_native_crypto_start_once(original, NULL);
+		if (sheng_corecrypto_status != KERN_SUCCESS) {
+			panic("SHENG: original corecrypto failed: %d", sheng_corecrypto_status);
+		}
+		return;
+	}
+	info.address = sheng_crypto_image_prepare();
+	sheng_corecrypto_status = corecrypto_kext_start(&info, NULL);
+	if (sheng_corecrypto_status != KERN_SUCCESS) {
+		panic("SHENG source corecrypto failed: %d", sheng_corecrypto_status);
+	}
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_FIRST, sheng_corecrypto_bootstrap);
+#endif
diff --git a/osfmk/prng/sheng_crypto_image.h b/osfmk/prng/sheng_crypto_image.h
new file mode 100644
index 0000000..da0f44c
--- /dev/null
+++ b/osfmk/prng/sheng_crypto_image.h
@@ -0,0 +1,50 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef SHENG_CRYPTO_IMAGE_H
+#define SHENG_CRYPTO_IMAGE_H
+#include <libkern/section_keywords.h>
+#include <mach-o/loader.h>
+
+extern char sheng_cc26_text_start[] __SECTION_START_SYM("__TEXT_EXEC", "__cc26_text");
+extern char sheng_cc26_text_end[] __SECTION_END_SYM("__TEXT_EXEC", "__cc26_text");
+
+/* Expose the provider-owned Mach-O code view so POST excludes XNU code modified by static_if. */
+struct sheng_crypto_image {
+    struct mach_header_64 header;
+    struct segment_command_64 text;
+    struct segment_command_64 code;
+    struct section_64 section;
+};
+static SECURITY_READ_ONLY_LATE(struct sheng_crypto_image) sheng_crypto_image = {
+    .header = {.magic = MH_MAGIC_64, .cputype = CPU_TYPE_ARM64,
+               .cpusubtype = CPU_SUBTYPE_ARM64_ALL, .filetype = MH_KEXT_BUNDLE,
+               .ncmds = 2, .sizeofcmds = 2 * sizeof(struct segment_command_64) + sizeof(struct section_64),
+               .flags = MH_DYLIB_IN_CACHE},
+    .text = {.cmd = LC_SEGMENT_64, .cmdsize = sizeof(struct segment_command_64),
+             .segname = "__TEXT", .maxprot = VM_PROT_READ, .initprot = VM_PROT_READ},
+    .code = {.cmd = LC_SEGMENT_64, .cmdsize = sizeof(struct segment_command_64) + sizeof(struct section_64),
+             .segname = "__TEXT_EXEC", .maxprot = VM_PROT_READ | VM_PROT_EXECUTE,
+             .initprot = VM_PROT_READ | VM_PROT_EXECUTE, .nsects = 1},
+    .section = {.sectname = "__text", .segname = "__TEXT_EXEC", .align = 2,
+                .flags = S_REGULAR | S_ATTR_PURE_INSTRUCTIONS | S_ATTR_SOME_INSTRUCTIONS},
+};
+
+static vm_address_t
+sheng_crypto_image_prepare(void)
+{
+    uint64_t base = (uintptr_t)&sheng_crypto_image;
+    uint64_t start = (uintptr_t)sheng_cc26_text_start;
+    uint64_t end = (uintptr_t)sheng_cc26_text_end;
+    if (start < base + sizeof(sheng_crypto_image) || end <= start) {
+        panic("SHENG corecrypto has invalid module text bounds");
+    }
+    sheng_crypto_image.text.vmaddr = base;
+    sheng_crypto_image.text.vmsize = sizeof(sheng_crypto_image);
+    sheng_crypto_image.text.filesize = sizeof(sheng_crypto_image);
+    sheng_crypto_image.code.vmaddr = start;
+    sheng_crypto_image.code.vmsize = end - start;
+    sheng_crypto_image.code.filesize = end - start;
+    sheng_crypto_image.section.addr = start;
+    sheng_crypto_image.section.size = end - start;
+    return (vm_address_t)base;
+}
+#endif
diff --git a/osfmk/vm/sheng_language_pages_kernel.h b/osfmk/vm/sheng_language_pages_kernel.h
new file mode 100644
index 0000000..5764bbd
--- /dev/null
+++ b/osfmk/vm/sheng_language_pages_kernel.h
@@ -0,0 +1,43 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <vm/sheng_language_trace.h>
+#define SHENG_LANGUAGE_TRACE_PAGE_TABLE
+#include <vm/sheng_language_trace_pages.h>
+#undef SHENG_LANGUAGE_TRACE_PAGE_TABLE
+
+extern uint32_t sheng_language_trace_enabled;
+
+static void
+sheng_language_trace_page(vm_page_t page, struct vnode *vnode, uint64_t offset, bool validated)
+{
+    if (sheng_language_trace_enabled != 1)
+        return;
+    const size_t count = sizeof(sheng_language_trace_pages) / sizeof(sheng_language_trace_pages[0]);
+    for (size_t i = 0; i < count; i++) {
+        const struct sheng_ui_page *rule = &sheng_language_trace_pages[i];
+        if (offset != rule->file_offset)
+            continue;
+        const char *name = vnode_getname(vnode);
+        if (!name)
+            return;
+        bool match = !strcmp(name, rule->file);
+        vnode_putname(name);
+        if (!match)
+            return;
+        if (PAGE_SIZE != SHENG_UI_PAGE_BYTES || csr_check(CSR_ALLOW_UNAUTHENTICATED_ROOT) ||
+            !validated || page->vmp_cs_validated != VMP_CS_ALL_TRUE ||
+            page->vmp_cs_tainted != VMP_CS_ALL_FALSE || page->vmp_cs_nx != VMP_CS_ALL_FALSE ||
+            page->vmp_dirty || page->vmp_wpmapped)
+            panic("SHENG: Language trace requires an authenticated immutable development page");
+        uint8_t *bytes = (uint8_t *)phystokv((pmap_paddr_t)VM_PAGE_GET_PHYS_PAGE(page) << PAGE_SHIFT);
+        int result = sheng_ui_apply_page(bytes, PAGE_SIZE, rule, sheng_recovery_ui_digest);
+        if (result < 0)
+            panic("SHENG: Language trace page %zu differs from 25F71", i);
+        if (result) {
+            cache_sync_page(VM_PAGE_GET_PHYS_PAGE(page));
+            printf("SHENG-LANGUAGE: trace page %zu installed\n", i);
+        }
+        return;
+    }
+}
diff --git a/osfmk/vm/sheng_language_trace.h b/osfmk/vm/sheng_language_trace.h
new file mode 100644
index 0000000..7d19918
--- /dev/null
+++ b/osfmk/vm/sheng_language_trace.h
@@ -0,0 +1,19 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+struct sheng_language_point {
+    uint32_t rva;
+    uint16_t tag;
+    uint8_t destination;
+    uint8_t branch;
+    const char *name;
+};
+
+// Only the pinned CBNZ X0,+20 and MOV X19/X20/X24,X0 sites are replayable.
+static inline int
+sheng_language_step(const struct sheng_language_point *point, uint64_t x0)
+{
+    if (point->branch)
+        return point->branch == 1 && !point->destination ? (x0 ? 20 : 4) : 0;
+    return point->destination == 19 || point->destination == 20 || point->destination == 24 ? 4 : 0;
+}
diff --git a/osfmk/vm/sheng_language_trace_kernel.h b/osfmk/vm/sheng_language_trace_kernel.h
new file mode 100644
index 0000000..b0132a3
--- /dev/null
+++ b/osfmk/vm/sheng_language_trace_kernel.h
@@ -0,0 +1,54 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <vm/sheng_recovery_ui.h>
+#include <vm/sheng_language_trace.h>
+#include <vm/sheng_language_trace_pages.h>
+
+extern void proc_selfname(char *, int);
+extern int proc_selfpid(void);
+extern uint32_t sheng_recovery_ui_enabled;
+TUNABLE(uint32_t, sheng_language_trace_enabled, "sheng-language-trace", 0);
+
+static bool
+sheng_language_trace(arm_saved_state_t *state, uint64_t esr)
+{
+    if (sheng_language_trace_enabled != 1 || sheng_recovery_ui_enabled != 1 ||
+        !is_saved_state64(state) || !PSR64_IS_USER(get_saved_state_cpsr(state)))
+        return false;
+    uint16_t tag = ISS_BRK_COMMENT(esr);
+    const size_t count = sizeof(sheng_language_points) / sizeof(sheng_language_points[0]);
+    if (tag < 0x5a01 || tag >= 0x5a01 + count)
+        return false;
+    const struct sheng_language_point *point = &sheng_language_points[tag - 0x5a01];
+    uint64_t pc = get_saved_state_pc(state);
+    if (pc < 0x100000000ULL + point->rva || ((pc - point->rva) & 0x3fff))
+        return false;
+    char name[32] = {0};
+    proc_selfname(name, sizeof(name));
+    if (strcmp(name, "Language Chooser"))
+        return false;
+    uint32_t instruction = 0;
+    uint8_t identity[sizeof(sheng_language_uuid_command)];
+    if (copyin(pc, &instruction, sizeof(instruction)) ||
+        instruction != (0xd4200000u | (uint32_t)tag << 5) ||
+        copyin(pc - point->rva + SHENG_LANGUAGE_UUID_OFFSET, identity, sizeof(identity)) ||
+        memcmp(identity, sheng_language_uuid_command, sizeof(identity)))
+        return false;
+    uint64_t value = get_saved_state_reg(state, 0);
+    int step = sheng_language_step(point, value);
+    if (!step)
+        return false;
+    // Bound console traffic while continuing to replay every matching instruction.
+    static uint32_t samples[sizeof(sheng_language_points) / sizeof(sheng_language_points[0])];
+    uint32_t sample = __atomic_add_fetch(&samples[tag - 0x5a01], 1, __ATOMIC_RELAXED);
+    if (sample <= 32)
+        printf("SHENG-LANGUAGE: %s pid=%d sample=%u value=%llu\n", point->name,
+            proc_selfpid(), sample, (unsigned long long)(point->branch || point->tag == 0x5a03 ? value : !!value));
+    // X19/X20/X24 are outside XNU's signed PC/LR/CPSR/X16/X17 tuple.
+    if (!point->branch)
+        saved_state64(state)->x[point->destination] = value;
+    // Use XNU's user-state signing helper; retain flags, SP, LR and all other registers.
+    add_user_saved_state_pc(state, step);
+    return true;
+}
