diff --git a/pexpert/arm/pe_sheng_boot_progress.h b/pexpert/arm/pe_sheng_boot_progress.h
new file mode 100644
index 0000000..2583e2a
--- /dev/null
+++ b/pexpert/arm/pe_sheng_boot_progress.h
@@ -0,0 +1,134 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#ifndef SHENG_BOOT_PROGRESS_H
+#define SHENG_BOOT_PROGRESS_H
+#include <stdint.h>
+#include <stddef.h>
+
+#define SHENG_BOOT_STAGES 10u
+#define SHENG_BOOT_SERVICES 10u
+struct sheng_boot_service {
+    uint32_t starts, exits;
+    int pid, status, running;
+};
+struct sheng_boot_progress {
+    uint32_t mask, stage, last_service, log_state, log_error;
+    uint64_t now, changed, service_changed, generation, events_lost;
+    struct sheng_boot_service service[SHENG_BOOT_SERVICES];
+};
+
+static const char *const sheng_boot_stage_names[SHENG_BOOT_STAGES] = {
+    "Kernel", "VM ready", "IOKit entry", "Root mounted", "launchd exec",
+    "Recovery exec", "WindowServer exec", "Display on", "First swap", "First frame"
+};
+static const char *const sheng_boot_service_names[SHENG_BOOT_SERVICES] = {
+    "launchd", "recoveryosd", "RecoveryOS Agent", "WindowServer", "Language Chooser",
+    "Recovery Springb", "lsd", "coreservicesd", "loginwindow", "diskarbitrationd"
+};
+
+static int sheng_boot_service_index(const char *name)
+{
+    if (!name) return -1;
+    for (unsigned i = 0; i < SHENG_BOOT_SERVICES; i++) {
+        unsigned n = 0;
+        while (n < 16 && name[n] && name[n] == sheng_boot_service_names[i][n]) n++;
+        if (n <= 16 && !name[n] && !sheng_boot_service_names[i][n]) return (int)i;
+    }
+    return -1;
+}
+
+/* A repeated milestone never refreshes the last-progress timestamp. */
+static int sheng_boot_mark(struct sheng_boot_progress *state, unsigned stage, uint64_t now)
+{
+    if (stage >= SHENG_BOOT_STAGES || now < state->now) return 0;
+    state->now = now;
+    const uint32_t bit = 1u << stage;
+    if (state->mask & bit) return 0;
+    state->mask |= bit;
+    if (stage > state->stage) state->stage = stage;
+    state->changed = now;
+    return 1;
+}
+
+static int sheng_boot_service_event(struct sheng_boot_progress *state, const char *name,
+    int pid, int exiting, int status, uint64_t now)
+{
+    const int index = sheng_boot_service_index(name);
+    if (index < 0 || pid <= 0 || now < state->now) return 0;
+    struct sheng_boot_service *service = &state->service[index];
+    if (exiting) {
+        /* Ignore duplicate exits and an old PID after its replacement started. */
+        if (service->pid != pid || !service->running) return 0;
+        if (service->exits != UINT32_MAX) service->exits++;
+        service->status = status;
+        service->running = 0;
+    } else {
+        if (service->pid == pid && service->running) return 0;
+        if (service->starts != UINT32_MAX) service->starts++;
+        service->pid = pid;
+        service->status = 0;
+        service->running = 1;
+        unsigned stage = SHENG_BOOT_STAGES;
+        if (index == 0) stage = 4;
+        if (index == 1 || index == 2) stage = 5;
+        if (index == 3) stage = 6;
+        sheng_boot_mark(state, stage, now);
+        /* New services are progress; repeated starts retain the original age. */
+        if (service->starts == 1) state->changed = now;
+    }
+    state->now = now;
+    state->last_service = (unsigned)index;
+    state->service_changed = now;
+    return 1;
+}
+
+static void sheng_boot_append(char *out, unsigned *used, const char *text)
+{
+    while (*text && *used < 95) out[(*used)++] = *text++;
+    out[*used] = 0;
+}
+
+static void sheng_boot_number(char *out, unsigned *used, uint64_t value)
+{
+    char digits[20];
+    unsigned count = 0;
+    do { digits[count++] = (char)('0' + value % 10); value /= 10; } while (value);
+    while (count && *used < 95) out[(*used)++] = digits[--count];
+    out[*used] = 0;
+}
+
+/* Segments describe individual observed milestones, not elapsed time or percent. */
+static void sheng_boot_format(const struct sheng_boot_progress *state, uint64_t bytes,
+    uint64_t dropped, char lines[4][96])
+{
+    unsigned n = 0;
+    sheng_boot_append(lines[0], &n, "BOOT [");
+    for (unsigned i = 0; i < SHENG_BOOT_STAGES; i++)
+        sheng_boot_append(lines[0], &n, state->mask & (1u << i) ? "#" : "-");
+    sheng_boot_append(lines[0], &n, "] - ");
+    sheng_boot_append(lines[0], &n, sheng_boot_stage_names[state->stage < SHENG_BOOT_STAGES ? state->stage : 0]);
+    n = 0;
+    sheng_boot_append(lines[1], &n, "No new stage/service: ");
+    sheng_boot_number(lines[1], &n, state->now >= state->changed ? state->now - state->changed : 0);
+    sheng_boot_append(lines[1], &n, "s - no loop verdict");
+    n = 0;
+    if (state->last_service < SHENG_BOOT_SERVICES) {
+        const struct sheng_boot_service *service = &state->service[state->last_service];
+        sheng_boot_append(lines[2], &n, sheng_boot_service_names[state->last_service]);
+        sheng_boot_append(lines[2], &n, " pid="); sheng_boot_number(lines[2], &n, (unsigned)service->pid);
+        sheng_boot_append(lines[2], &n, " starts="); sheng_boot_number(lines[2], &n, service->starts);
+        sheng_boot_append(lines[2], &n, " exits="); sheng_boot_number(lines[2], &n, service->exits);
+        sheng_boot_append(lines[2], &n, " wait-status="); sheng_boot_number(lines[2], &n, (unsigned)service->status);
+    } else sheng_boot_append(lines[2], &n, "Services: no tracked exec yet");
+    n = 0;
+    const char *log_status = state->log_state == 0 ? "off" : state->log_state == 1 ? "opening" :
+        state->log_state == 2 ? "verified" : state->log_state == 3 ? "committed" :
+        state->log_state == 5 ? "stopped" : "unknown";
+    sheng_boot_append(lines[3], &n, "LOG "); sheng_boot_append(lines[3], &n, log_status);
+    sheng_boot_append(lines[3], &n, " gen="); sheng_boot_number(lines[3], &n, state->generation);
+    sheng_boot_append(lines[3], &n, " bytes="); sheng_boot_number(lines[3], &n, bytes);
+    sheng_boot_append(lines[3], &n, " drops="); sheng_boot_number(lines[3], &n, dropped);
+    sheng_boot_append(lines[3], &n, " error="); sheng_boot_number(lines[3], &n, state->log_error);
+    sheng_boot_append(lines[3], &n, " lost=");
+    sheng_boot_number(lines[3], &n, __atomic_load_n(&state->events_lost, __ATOMIC_RELAXED));
+}
+#endif
diff --git a/pexpert/arm/pe_sheng_boot_progress_kernel.h b/pexpert/arm/pe_sheng_boot_progress_kernel.h
new file mode 100644
index 0000000..1239613
--- /dev/null
+++ b/pexpert/arm/pe_sheng_boot_progress_kernel.h
@@ -0,0 +1,126 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+/* Included once by the retained-log owner; no allocation or waiting in hooks. */
+#include "pe_sheng_boot_progress.h"
+unsigned sheng_boot_progress_enabled;
+static uint32_t sheng_boot_progress_writer;
+struct sheng_boot_progress sheng_boot_progress_state = { .last_service = SHENG_BOOT_SERVICES };
+static uint64_t sheng_boot_progress_reported;
+static uint32_t sheng_boot_progress_reported_mask;
+
+uint64_t sheng_boot_progress_seconds(void);
+#include "pe_sheng_smp_log.h"
+
+static int sheng_boot_lock(void)
+{
+    uint32_t expected = 0;
+    if (__atomic_compare_exchange_n(&sheng_boot_progress_writer, &expected, 1, 0,
+        __ATOMIC_ACQUIRE, __ATOMIC_RELAXED)) return 1;
+    __atomic_fetch_add(&sheng_boot_progress_state.events_lost, 1, __ATOMIC_RELAXED);
+    return 0;
+}
+
+static void sheng_boot_unlock(void)
+{
+    __atomic_store_n(&sheng_boot_progress_writer, 0, __ATOMIC_RELEASE);
+}
+
+/* The unused bottom of the panic region owns four rows until a panic or GUI handoff. */
+static void sheng_boot_render(char lines[4][96])
+{
+    if (!sheng_panel_ready || !sheng_panic_panel.base || sheng_panic_panel.rows < 6 ||
+        __atomic_load_n(&sheng_panic_text_state, __ATOMIC_ACQUIRE) == 2) return;
+    const unsigned scale = sheng_panic_panel.scale;
+    const uintptr_t base = sheng_panic_panel.base + (sheng_panic_panel.rows - 4) *
+        16 * scale * sheng_panic_panel.stride;
+    for (unsigned line = 0; line < 4; line++) {
+        unsigned end = 0;
+        while (end < 95 && lines[line][end]) end++;
+        for (unsigned y = 0; y < 16 * scale; y++) {
+            uint64_t saved_daif;
+            if (!sheng_fb_begin(SHENG_FB_BOOT, &saved_daif)) return;
+            for (unsigned col = 0; col < sheng_panic_panel.columns; col++) {
+                const unsigned char c = col < end ? (unsigned char)lines[line][col] : ' ';
+                volatile uint32_t *pixels = (volatile uint32_t *)(base +
+                    (line * 16 * scale + y) * sheng_panic_panel.stride + col * 8 * scale * 4);
+                const unsigned bits = sheng_panel_font[c * 16 + y / scale];
+                for (unsigned x = 0; x < 8 * scale; x++)
+                    pixels[x] = bits & (1u << (x / scale)) ? 0xffffffffu : 0xff000000u;
+            }
+            sheng_fb_end(saved_daif);
+        }
+    }
+    __asm__ volatile("dsb sy" ::: "memory");
+}
+
+static void sheng_boot_emit(const char *text)
+{
+    const char *prefix = "\nSHENG-PROGRESS: ";
+    while (*prefix) sheng_log_putc(*prefix++);
+    for (unsigned i = 0; text[i] && i < 95; i++) sheng_log_putc(text[i]);
+    sheng_log_putc('\n');
+}
+
+/* Refresh ages without moving segments; emit at most one periodic summary per 30 seconds. */
+void sheng_boot_progress_tick(void)
+{
+    sheng_smp_log_tick();
+    if (!sheng_boot_progress_enabled || !sheng_boot_lock()) return;
+    uint64_t now = sheng_boot_progress_seconds();
+    if (now >= sheng_boot_progress_state.now) sheng_boot_progress_state.now = now;
+    char lines[4][96];
+    sheng_boot_format(&sheng_boot_progress_state,
+        __atomic_load_n(&sheng_log_buffer.total, __ATOMIC_RELAXED),
+        __atomic_load_n(&sheng_log_buffer.dropped, __ATOMIC_RELAXED), lines);
+    sheng_boot_render(lines);
+    int report = sheng_boot_progress_state.mask != sheng_boot_progress_reported_mask ||
+        (now >= sheng_boot_progress_reported && now - sheng_boot_progress_reported >= 30);
+    if (report) {
+        sheng_boot_progress_reported = now;
+        sheng_boot_progress_reported_mask = sheng_boot_progress_state.mask;
+    }
+    struct sheng_boot_progress snapshot = sheng_boot_progress_state;
+    sheng_boot_unlock();
+    if (report) {
+        for (unsigned i = 0; i < 4; i++) sheng_boot_emit(lines[i]);
+        /* A bounded inventory survives missing individual exec lines; zero starts means unobserved. */
+        for (unsigned i = 0; i < SHENG_BOOT_SERVICES; i++) {
+            snapshot.last_service = i;
+            sheng_boot_format(&snapshot, 0, 0, lines);
+            sheng_boot_emit(lines[2]);
+        }
+    }
+}
+
+void sheng_boot_checkpoint(unsigned stage)
+{
+    if (!sheng_boot_progress_enabled || !sheng_boot_lock()) return;
+    int changed = sheng_boot_mark(&sheng_boot_progress_state, stage, sheng_boot_progress_seconds());
+    sheng_boot_unlock();
+    if (changed) sheng_boot_progress_tick();
+}
+
+void sheng_boot_service(const char *name, int pid, int exiting, int status)
+{
+    if (!sheng_boot_progress_enabled || !sheng_boot_lock()) return;
+    int changed = sheng_boot_service_event(&sheng_boot_progress_state, name, pid,
+        exiting, status, sheng_boot_progress_seconds());
+    char line[96]; unsigned n = 0;
+    if (changed) {
+        sheng_boot_append(line, &n, exiting ? "exit " : "exec ");
+        sheng_boot_append(line, &n, sheng_boot_service_names[sheng_boot_progress_state.last_service]);
+        sheng_boot_append(line, &n, " pid="); sheng_boot_number(line, &n, (unsigned)pid);
+        sheng_boot_append(line, &n, " wait-status="); sheng_boot_number(line, &n, (unsigned)status);
+    }
+    sheng_boot_unlock();
+    if (changed) { sheng_boot_emit(line); sheng_boot_progress_tick(); }
+}
+
+void sheng_boot_log_state(unsigned state, unsigned error, uint64_t generation)
+{
+    if (!sheng_boot_progress_enabled || !sheng_boot_lock()) return;
+    sheng_boot_progress_state.log_state = state;
+    sheng_boot_progress_state.log_error = error;
+    sheng_boot_progress_state.generation = generation;
+    sheng_boot_unlock();
+    sheng_boot_progress_tick();
+}
