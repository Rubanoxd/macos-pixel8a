+	char device[64] = {0};
+	unsigned data_mb = 0;
+	if (!PE_parse_boot_arg_str("akita-fullos-cryptex", uuid, sizeof(uuid)) || !uuid[0]) {
+		return;
+	}
+	PE_parse_boot_argn("akita-fullos-data-mb", &data_mb, sizeof(data_mb));
