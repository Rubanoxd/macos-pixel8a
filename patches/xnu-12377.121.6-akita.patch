diff --git a/osfmk/vm/sheng_recovery_ui.h b/osfmk/vm/sheng_recovery_ui.h
new file mode 100644
index 0000000..cb9bc72
--- /dev/null
+++ b/osfmk/vm/sheng_recovery_ui.h
@@ -0,0 +1,69 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+
+#define SHENG_UI_PAGE_BYTES 16384u
+#define SHENG_UI_MAX_EDITS 4u
+#define SHENG_UI_MAX_EDIT_BYTES 16u
+
+struct sheng_ui_edit {
+    uint32_t offset;
+    uint32_t size;
+    uint8_t before[SHENG_UI_MAX_EDIT_BYTES];
+    uint8_t after[SHENG_UI_MAX_EDIT_BYTES];
+};
+
+struct sheng_ui_page {
+    const char *file;
+    uint64_t file_offset;
+    uint8_t before_sha256[32];
+    uint8_t after_sha256[32];
+    uint32_t edit_count;
+    struct sheng_ui_edit edits[SHENG_UI_MAX_EDITS];
+};
+
+typedef void (*sheng_ui_digest)(const void *, size_t, uint8_t[32]);
+
+// The caller owns a busy, originally authenticated page under its object lock.
+// Check the whole page and every edit before writing; retain original disk data.
+// Return 1 for a new application, 0 for an already applied page, -1 on mismatch.
+static inline int
+sheng_ui_apply_page(uint8_t *page, size_t size, const struct sheng_ui_page *rule,
+                   sheng_ui_digest digest)
+{
+    uint8_t hash[32];
+    if (size != SHENG_UI_PAGE_BYTES || !rule->edit_count || rule->edit_count > SHENG_UI_MAX_EDITS)
+        return -1;
+    for (uint32_t i = 0; i < rule->edit_count; i++) {
+        const struct sheng_ui_edit *edit = &rule->edits[i];
+        if (!edit->size || edit->size > SHENG_UI_MAX_EDIT_BYTES || (edit->size | edit->offset) & 3u ||
+            edit->offset > SHENG_UI_PAGE_BYTES - edit->size)
+            return -1;
+        for (uint32_t j = 0; j < i; j++) {
+            const struct sheng_ui_edit *other = &rule->edits[j];
+            if (edit->offset < other->offset + other->size && other->offset < edit->offset + edit->size)
+                return -1;
+        }
+    }
+    digest(page, size, hash);
+    if (!memcmp(hash, rule->after_sha256, sizeof(hash)))
+        return 0;
+    if (memcmp(hash, rule->before_sha256, sizeof(hash)))
+        return -1;
+    for (uint32_t i = 0; i < rule->edit_count; i++) {
+        const struct sheng_ui_edit *edit = &rule->edits[i];
+        if (memcmp(page + edit->offset, edit->before, edit->size))
+            return -1;
+    }
+    for (uint32_t i = 0; i < rule->edit_count; i++) {
+        const struct sheng_ui_edit *edit = &rule->edits[i];
+        memcpy(page + edit->offset, edit->after, edit->size);
+    }
+    digest(page, size, hash);
+    if (!memcmp(hash, rule->after_sha256, sizeof(hash)))
+        return 1;
+    for (uint32_t i = 0; i < rule->edit_count; i++) {
+        const struct sheng_ui_edit *edit = &rule->edits[i];
+        memcpy(page + edit->offset, edit->before, edit->size);
+    }
+    return -1;
+}
diff --git a/osfmk/vm/sheng_recovery_ui_kernel.h b/osfmk/vm/sheng_recovery_ui_kernel.h
new file mode 100644
index 0000000..db45b1d
--- /dev/null
+++ b/osfmk/vm/sheng_recovery_ui_kernel.h
@@ -0,0 +1,83 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+
+#include <arm/caches_internal.h>
+#include <libkern/crypto/sha2.h>
+#include <sys/csr.h>
+#include <vm/sheng_recovery_ui.h>
+#include <vm/sheng_recovery_ui_pages.h>
+
+// Keep the VM translation unit independent of the BSD vnode header's type namespace.
+extern const char *vnode_getname(struct vnode *);
+extern void vnode_putname(const char *);
+
+TUNABLE(uint32_t, sheng_recovery_ui_enabled, "sheng-recovery-ui", 0);
+// Bit i leaves policy i unapplied (akita: bit 5 drops recovery-guest-fallback, so Recovery opens the
+// normal flow instead of the guest Web Browser).
+TUNABLE(uint32_t, sheng_recovery_ui_skip, "sheng-recovery-ui-skip", 0);
+volatile uint32_t sheng_recovery_ui_pages_applied;
+volatile uint32_t sheng_recovery_ui_page_mask;
+
+static void
+sheng_recovery_ui_digest(const void *data, size_t size, uint8_t result[32])
+{
+    SHA256_CTX context;
+    SHA256_Init(&context);
+    SHA256_Update(&context, data, size);
+    SHA256_Final(result, &context);
+}
+
+#include <vm/sheng_language_pages_kernel.h>
+
+static void
+sheng_recovery_ui_page(vm_page_t page, struct vnode *vnode, uint64_t offset, bool original_validated)
+{
+    if (!sheng_recovery_ui_enabled)
+        return;
+    if (sheng_recovery_ui_enabled == 1)
+        sheng_language_trace_page(page, vnode, offset, original_validated);
+    const size_t count = sizeof(sheng_ui_pages) / sizeof(sheng_ui_pages[0]);
+    bool candidate = false;
+    for (size_t i = 0; i < count; i++)
+        candidate |= offset == sheng_ui_pages[i].file_offset;
+    if (!candidate)
+        return;
+    const char *name = vnode_getname(vnode);
+    if (!name)
+        return;
+    for (size_t i = 0; i < count; i++) {
+        const struct sheng_ui_page *rule = &sheng_ui_pages[i];
+        if (offset != rule->file_offset || strcmp(name, rule->file))
+            continue;
+        vnode_putname(name);
+        if (i < 32 && (sheng_recovery_ui_skip & ((uint32_t)1 << i)))
+            return;
+        // Never turn a failed signature, writable page, or production boot into an accepted image.
+        if (sheng_recovery_ui_enabled != 1 || PAGE_SIZE != SHENG_UI_PAGE_BYTES ||
+            csr_check(CSR_ALLOW_UNAUTHENTICATED_ROOT) != 0 || !original_validated ||
+            page->vmp_cs_validated != VMP_CS_ALL_TRUE || page->vmp_cs_tainted != VMP_CS_ALL_FALSE ||
+            page->vmp_cs_nx != VMP_CS_ALL_FALSE || page->vmp_dirty || page->vmp_wpmapped)
+            panic("SHENG: Recovery UI policy %zu requires an authenticated immutable development page", i);
+        // The validation mapping can be read-only; write through the owned busy physical page instead.
+        uint8_t *bytes = (uint8_t *)phystokv((pmap_paddr_t)VM_PAGE_GET_PHYS_PAGE(page) << PAGE_SHIFT);
+        int result = sheng_ui_apply_page(bytes, PAGE_SIZE, rule, sheng_recovery_ui_digest);
+        if (result < 0) {
+            // akita: a same-named file of another volume (the full macOS SystemOS cryptex mounted from Recovery)
+            // reaches this offset with different contents. Leave such a page untouched instead of stopping:
+            // only the exact pinned page is ever modified.
+            static volatile SInt32 sheng_recovery_ui_foreign_logged;
+            if (OSAddAtomic(1, &sheng_recovery_ui_foreign_logged) < 8)
+                printf("SHENG: Recovery UI policy %zu: foreign page left unmodified\n", i);
+            return;
+        }
+        if (result) {
+            // Use the same physical-page coherence primitive as UniXNU's native text fixups.
+            cache_sync_page(VM_PAGE_GET_PHYS_PAGE(page));
+            OSAddAtomic(1, (volatile SInt32 *)&sheng_recovery_ui_pages_applied);
+            OSBitOrAtomic((uint32_t)1 << i, &sheng_recovery_ui_page_mask);
+            printf("SHENG: Recovery UI policy %zu applied - authenticated memory only\n", i);
+        }
+        return;
+    }
+    vnode_putname(name);
+}
