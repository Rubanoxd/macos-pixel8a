+ pacga \lo, \seed, \tag
+ lsr \lo, \lo, #32
+ MOV32 \tag, (0x53480001 | (\domain << 8))
+ pacga \part, \seed, \tag
+ orr \lo, \lo, \part
+ MOV32 \tag, (0x53480002 | (\domain << 8))
+ pacga \hi, \seed, \tag
+ lsr \hi, \hi, #32
