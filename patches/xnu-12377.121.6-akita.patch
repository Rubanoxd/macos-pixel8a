+SYSCTL_PROC(_kern, OID_AUTO, akita_phys_wr, CTLTYPE_INT | CTLFLAG_WR | CTLFLAG_LOCKED, 0, 0,
+    sysctl_akita_phys_wr, "IU", "akita: 32-bit write at akita_phys_addr");
