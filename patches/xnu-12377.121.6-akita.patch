+/* SPDX-License-Identifier: MIT */
+/* Native EL1 platform, based on the verified UniXNU sheng machine layer. */
+#ifndef _PEXPERT_ARM64_SHENG_H
+#define _PEXPERT_ARM64_SHENG_H
+
+#define SHENG                            1
+#if defined(__arm64e__)
+/* XNU PAC ABI uses architectural instructions, without Apple registers or HVC. */
+#define HAS_APPLE_PAC                    1
+#define HAS_NATIVE_EL1_PAC               1
+#if !__has_feature(ptrauth_calls)
+#error SHENG ARM64E requires compiler pointer authentication
+#endif
+#endif
+#define NO_MONITOR                       1
+#define NO_ECORE                         1
+#define ARM_ARCH_TIMER
+#define __ARM_16K_PG__                   1
+#define __ARM_ARCH__                     8
+#define __ARM_VMSA__                     8
+#define __ARM_VFP__                      4
+#define __ARM_COHERENT_CACHE__            1
+#define __ARM_DEBUG__                    7
+#define __ARM_PAN_AVAILABLE__            1
+#if !ARM_LARGE_MEMORY
+#define __ARM64_PMAP_SUBPAGE_L1__         1
+#define __ARM64_PMAP_KERN_SUBPAGE_L1__    1
+#endif
+
+#endif /* _PEXPERT_ARM64_SHENG_H */
