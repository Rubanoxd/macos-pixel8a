+void akita_print_task_stacks(task_t task);
+void
+akita_print_task_stacks(task_t task)
+{
+	thread_t thread;
+	uint64_t frames[24];
+	task_lock(task);
+	queue_iterate(&task->threads, thread, thread_t, task_threads) {
+		if (thread == current_thread() || !(thread->state & TH_WAIT)) {
+			continue;
+		}
+		/* A thread blocked with a continuation has no kernel stack (kstackptr NULL): nothing to walk. */
+		if (thread->kernel_stack == 0 || thread->machine.kstackptr == NULL) {
+			printf("AKSTK tid=%llu st=0x%x wait=0x%llx: (no kernel stack)\n", thread_tid(thread), thread->state,
+			    (uint64_t)VM_KERNEL_UNSLIDE_OR_PERM(thread->wait_event));
+			continue;
+		}
+		uint32_t flags = 0;
+		bzero(frames, sizeof(frames));
+		int bytes = machine_trace_thread64(thread, (char *)frames, (char *)(frames + 24), 24, &flags);
+		int n = bytes / (int)sizeof(uint64_t);
+		char line[24 * 19 + 1];
+		size_t off = 0;
+		line[0] = 0;
+		for (int i = 0; i < n && off < sizeof(line); i++) {
+			off += scnprintf(line + off, sizeof(line) - off, " %llx", frames[i]);
+		}
+		printf("AKSTK tid=%llu st=0x%x wait=0x%llx:%s\n", thread_tid(thread), thread->state,
+		    (uint64_t)VM_KERNEL_UNSLIDE_OR_PERM(thread->wait_event), line);
+	}
+	task_unlock(task);
+}
