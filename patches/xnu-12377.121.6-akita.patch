+sysctl_akita_phys_val SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	volatile uint32_t *reg = akita_phys_map();
+	if (reg == NULL) {
+		return EINVAL;
+	}
+	int value = (int)*reg;
+	return sysctl_handle_int(oidp, &value, 0, req);
+}
+SYSCTL_PROC(_kern, OID_AUTO, akita_phys_val, CTLTYPE_INT | CTLFLAG_RD | CTLFLAG_LOCKED, 0, 0,
+    sysctl_akita_phys_val, "IU", "akita: 32-bit read at akita_phys_addr");
