+	if (reg == NULL) {
+		return EINVAL;
+	}
+	*reg = (uint32_t)value;
+	__builtin_arm_dsb(0xf);
+	printf("AKITA PHYS: wrote 0x%08x to 0x%llx\n", (uint32_t)value, akita_phys_addr);
+	return 0;
