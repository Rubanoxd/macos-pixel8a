+
+/* Own a separate pixel region and cursor; never wait for a normal writer interrupted by panic. */
+static void sheng_panic_panel_render(void)
+{
+    if (!sheng_panic_panel.base ||
+        __atomic_load_n(&sheng_panic_text_state, __ATOMIC_ACQUIRE) != 2) return;
+    const unsigned scale = sheng_panic_panel.scale;
+    for (unsigned y = 0; y < sheng_panic_panel.rows * 16 * scale; y++) {
+        volatile uint32_t *pixels = (volatile uint32_t *)(sheng_panic_panel.base +
+            y * sheng_panic_panel.stride);
+        for (unsigned x = 0; x < sheng_panic_panel.columns * 8 * scale; x++) pixels[x] = 0xff000000u;
+    }
+    const unsigned width = sheng_panic_panel.columns * 8 * scale;
+    const unsigned height = sheng_panic_panel.rows * 16 * scale;
+    unsigned qr_scale = 0, qr_extent = sheng_qr_extent(width, height, &qr_scale);
+    const unsigned text_columns = qr_extent ? (width - qr_extent - 8 * scale) / (8 * scale)
+        : sheng_panic_panel.columns;
+    unsigned row = 0, column = 0;
+    for (unsigned part = 0; part < 2; part++) {
+        const char *text = part ? sheng_first_panic_text : "SHENG - PANIC DETAIL\n";
+        for (unsigned n = 0; text[n] && n < 4095 && row < sheng_panic_panel.rows; n++) {
+            const unsigned char c = (unsigned char)text[n];
+            if (c == '\r') { column = 0; continue; }
+            if (c == '\n') { column = 0; row++; continue; }
+            if (c < 32 || c > 126) continue;
+            const uintptr_t origin = sheng_panic_panel.base +
+                row * 16 * scale * sheng_panic_panel.stride + column * 8 * scale * 4;
+            for (unsigned y = 0; y < 16 * scale; y++) {
+                volatile uint32_t *pixels = (volatile uint32_t *)(origin + y * sheng_panic_panel.stride);
+                const unsigned bits = sheng_panel_font[c * 16 + y / scale];
+                for (unsigned x = 0; x < 8 * scale; x++)
+                    pixels[x] = bits & (1u << (x / scale)) ? 0xffffffffu : 0xff000000u;
+            }
+            if (++column == text_columns) { column = 0; row++; }
+        }
+    }
+    sheng_qr_draw(sheng_panic_panel.base, sheng_panic_panel.stride, width, height);
+    __asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/* Map the separate text region in the same native mapping; do not share pixels with the old stage strip. */
+static void sheng_status_render(const char *prefix, const char *message)
+{
+    const uintptr_t base = sheng_status_pixels;
+    const uintptr_t stride = sheng_bootstrap_vm_stride;
+    const unsigned scale = (unsigned)sheng_status_scale;
+    if (!base || stride < 2560 || stride > 65536 || (scale != 1 && scale != 2)) return;
+    uint32_t expected = 0;
+    if (!__atomic_compare_exchange_n(&sheng_status_writer, &expected, 1, 0,
+        __ATOMIC_ACQUIRE, __ATOMIC_RELAXED)) return;
+    unsigned length = 0;
+    while (prefix && *prefix && length < 44) sheng_status_message[length++] = *prefix++;
+    while (message && *message && length < 44) {
+        const unsigned char c = (unsigned char)*message++;
+        if (c >= 32 && c <= 126) sheng_status_message[length++] = (char)c;
+    }
+    sheng_status_message[length] = 0;
+    uintptr_t white = 0;
+    for (unsigned line = 0; line < 2; line++) {
+        const char *text = line ? sheng_status_message :
+            (sheng_status_pinned == 2 ? "SHENG - FIRST EL1 SYNC" :
+             sheng_status_pinned ? "SHENG - FIRST PANIC" : "SHENG - BOOT LOG");
+        unsigned col = 0;
+        for (; col < 44; col++) {
+            const unsigned char c = *text ? (unsigned char)*text++ : ' ';
+            for (unsigned row = 0; row < 16; row++) {
+                const unsigned bits = sheng_panel_font[c * 16 + row];
+                for (unsigned y = 0; y < scale; y++) {
+                    uint64_t saved;
+                    if (!sheng_fb_begin(SHENG_FB_BOOT, &saved)) goto out;
+                    volatile uint32_t *pixels = (volatile uint32_t *)(base +
+                        ((line * 16 + row) * scale + y) * stride + col * 8 * scale * 4);
+                    for (unsigned x = 0; x < 8; x++) {
+                        const uint32_t color = bits & (1u << x) ? 0xffffffffu : 0xff000000u;
+                        for (unsigned sx = 0; sx < scale; sx++) pixels[x * scale + sx] = color;
+                        if (!white && color == 0xffffffffu) white = (uintptr_t)&pixels[x * scale];
+                    }
+                    sheng_fb_end(saved);
+                }
+            }
+        }
+    }
+    __asm__ volatile ("dsb sy" ::: "memory");
+    if (white && *(volatile uint32_t *)white == 0xffffffffu) sheng_status_witness = 1;
+out:
+    __atomic_store_n(&sheng_status_writer, 0, __ATOMIC_RELEASE);
+}
+
+void sheng_log_status(const char *message)
+{
+    if (sheng_status_pinned) sheng_status_render("", sheng_status_message);
+    else sheng_status_render("SHENG: ", message);
+}
+
+static void sheng_status_panic(const char *message)
+{
+    if (sheng_status_pinned) return;
+    sheng_status_pinned = 1;
+    sheng_status_render("PANIC: ", message);
+}
+
+static struct {
+    uintptr_t base;
+    unsigned stride, columns, rows, scale, x, y, pinned;
+} sheng_panel;
+
+static void sheng_panel_clear_row(unsigned row)
+{
+    if (row >= sheng_panel.rows) return;
+    for (unsigned y = 0; y < 16 * sheng_panel.scale; y++) {
+        uint64_t saved;
+        if (!sheng_fb_begin(SHENG_FB_BOOT, &saved)) return;
+        volatile uint32_t *p = (volatile uint32_t *)(sheng_panel.base +
+            (row * 16 * sheng_panel.scale + y) * sheng_panel.stride);
+        for (unsigned x = 0; x < sheng_panel.columns * 8 * sheng_panel.scale; x++) {
+            p[x] = 0xff000000u;
+        }
+        sheng_fb_end(saved);
+    }
+}
+
+static void sheng_panel_reset(void)
+{
+    sheng_panel.x = sheng_panel.y = sheng_panel.pinned = 0;
+    if (!sheng_panel_ready) return;
+    for (unsigned row = 0; row < sheng_panel.rows; row++) sheng_panel_clear_row(row);
+}
+
+/*
+ * sheng-panel-wrap=1 (akita): the frame buffer is mapped as device memory, where the word-by-word scroll
+ * below reads about a million pixels per line and a verbose boot takes minutes. Wrapping writes only: the
+ * cursor returns to the first unpinned row, which is cleared, and the row after it marks the oldest line.
+ */
+static unsigned sheng_panel_wrap;
+
+static void sheng_panel_newline(void)
+{
+    sheng_panel.x = 0;
+    if (!sheng_panel.rows) return;
+    if (sheng_panel_wrap && sheng_panel.y >= sheng_panel.rows - 1) {
+        sheng_panel.y = sheng_panel.pinned;
+        sheng_panel_clear_row(sheng_panel.y);
+        if (sheng_panel.y + 1 < sheng_panel.rows) sheng_panel_clear_row(sheng_panel.y + 1);
+        return;
+    }
+    if (sheng_panel_wrap) {
+        sheng_panel.y++;
+        sheng_panel_clear_row(sheng_panel.y);
+        if (sheng_panel.y + 1 < sheng_panel.rows) sheng_panel_clear_row(sheng_panel.y + 1);
+        return;
+    }
+    if (sheng_panel.y >= sheng_panel.rows - 1) {
+        /* Commit a valid cursor before any try-only scanline can skip the scroll. */
+        sheng_panel.y = sheng_panel.rows - 1;
+        /* Access the I/O mapping word by word; avoid memory routines that may use SIMD or DC ZVA. */
+        const unsigned pixels = sheng_panel.columns * 8 * sheng_panel.scale;
+        for (unsigned row = sheng_panel.pinned; row + 1 < sheng_panel.rows; row++) {
+            for (unsigned y = 0; y < 16 * sheng_panel.scale; y++) {
+                uint64_t saved;
+                if (!sheng_fb_begin(SHENG_FB_BOOT, &saved)) return;
+                volatile uint32_t *dst = (volatile uint32_t *)(sheng_panel.base +
+                    (row * 16 * sheng_panel.scale + y) * sheng_panel.stride);
+                volatile uint32_t *src = (volatile uint32_t *)((uintptr_t)dst +
+                    16 * sheng_panel.scale * sheng_panel.stride);
+                for (unsigned x = 0; x < pixels; x++) dst[x] = src[x];
+                sheng_fb_end(saved);
+            }
+        }
+    } else {
+        sheng_panel.y++;
+    }
+    sheng_panel_clear_row(sheng_panel.y);
+}
+
+static void sheng_panel_putc(unsigned char byte)
+{
+    if (!sheng_panel_ready || __atomic_load_n(&sheng_framebuffer.owner, __ATOMIC_ACQUIRE) != SHENG_FB_BOOT) return;
+    if (!sheng_panel.rows || !sheng_panel.columns) return;
+    if (sheng_panel.y >= sheng_panel.rows) sheng_panel.y = sheng_panel.rows - 1;
+    if (sheng_panel.x >= sheng_panel.columns) sheng_panel.x = 0;
+    if (byte == '\r') { sheng_panel.x = 0; return; }
+    if (byte == '\n') { sheng_panel_newline(); return; }
+    if (byte < 32 || byte > 126) return;
+    const unsigned scale = sheng_panel.scale;
+    const uintptr_t origin = sheng_panel.base + sheng_panel.y * 16 * scale * sheng_panel.stride +
+        sheng_panel.x * 8 * scale * sizeof(uint32_t);
+    uintptr_t white = 0;
+    for (unsigned row = 0; row < 16; row++) {
+        const unsigned bits = sheng_panel_font[byte * 16 + row];
+        for (unsigned y = 0; y < scale; y++) {
+            uint64_t saved;
+            if (!sheng_fb_begin(SHENG_FB_BOOT, &saved)) return;
+            volatile uint32_t *p = (volatile uint32_t *)(origin + (row * scale + y) * sheng_panel.stride);
+            for (unsigned col = 0; col < 8; col++) {
+                const uint32_t color = bits & (1u << col) ? 0xffffffffu : 0xff000000u;
+                for (unsigned x = 0; x < scale; x++) p[col * scale + x] = color;
+                if (!white && color == 0xffffffffu) white = (uintptr_t)&p[col * scale];
+            }
+            sheng_fb_end(saved);
+        }
+    }
+    __asm__ volatile ("dsb sy" ::: "memory");
+    if (white && *(volatile uint32_t *)white == 0xffffffffu) sheng_panel_witness = 1;
+    sheng_panel_characters++;
+    if (++sheng_panel.x == sheng_panel.columns) sheng_panel_newline();
+}
+
+static void sheng_panel_pin_panic(void)
+{
+    if (!sheng_panel_ready) return;
+    sheng_panel.pinned = sheng_panel.y + 1;
+    if (sheng_panel.pinned > sheng_panel.rows - 2) sheng_panel.pinned = sheng_panel.rows - 2;
+    sheng_panel.y = sheng_panel.pinned;
+    sheng_panel.x = 0;
+    sheng_panel_clear_row(sheng_panel.y);
+}
diff --git a/pexpert/arm/pe_sheng_panic_qr.h b/pexpert/arm/pe_sheng_panic_qr.h
new file mode 100644
index 0000000..71f1c36
--- /dev/null
+++ b/pexpert/arm/pe_sheng_panic_qr.h
@@ -0,0 +1,95 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef SHENG_PANIC_QR_H
+#define SHENG_PANIC_QR_H
+#include "pe_sheng_qr_encoder.h"
+#define SHENG_QR_PAYLOAD_MAX 640u
+#define SHENG_QR_REASON_MAX 256u
+#define SHENG_QR_VERSION_MAX 20
+struct sheng_panic_qr_capture {
+    uint64_t caller, sp, elr, esr, far;
+    uint64_t physical_base, image_va, total, dropped;
+    uint8_t uuid[16];
+};
+static uint8_t sheng_qr_scratch[qrcodegen_BUFFER_LEN_FOR_VERSION(SHENG_QR_VERSION_MAX)];
+static uint8_t sheng_qr_modules[qrcodegen_BUFFER_LEN_FOR_VERSION(SHENG_QR_VERSION_MAX)];
+static char sheng_qr_payload[SHENG_QR_PAYLOAD_MAX];
+static uint32_t sheng_qr_state;
+static unsigned sheng_qr_payload_bytes;
+static struct sheng_panic_qr_capture sheng_qr_capture;
+
+static void sheng_qr_append(unsigned *used, const char *text)
+{
+    while (*text && *used + 1 < SHENG_QR_PAYLOAD_MAX) sheng_qr_payload[(*used)++] = *text++;
+    sheng_qr_payload[*used] = 0;
+}
+static void sheng_qr_hex(unsigned *used, uint64_t value, unsigned digits)
+{
+    static const char hex[] = "0123456789ABCDEF";
+    for (unsigned i = digits; i && *used + 1 < SHENG_QR_PAYLOAD_MAX; i--)
+        sheng_qr_payload[(*used)++] = hex[(value >> ((i - 1) * 4)) & 15];
+    sheng_qr_payload[*used] = 0;
+}
+/* Only the first panic owns these static buffers; recursion returns without waiting. */
+static int sheng_qr_prepare(const struct sheng_panic_qr_capture *capture, const char *reason)
+{
+    uint32_t expected = 0;
+    if (!__atomic_compare_exchange_n(&sheng_qr_state, &expected, 1, 0,
+        __ATOMIC_ACQUIRE, __ATOMIC_RELAXED)) return 0;
+    sheng_qr_capture = *capture;
+    unsigned used = 0;
+    sheng_qr_append(&used, "SHENG-PANIC-1\nUUID=");
+    for (unsigned i = 0; i < 16; i++) {
+        if (i == 4 || i == 6 || i == 8 || i == 10) sheng_qr_append(&used, "-");
+        sheng_qr_hex(&used, capture->uuid[i], 2);
+    }
+    const char *keys[] = {"\nCALLER=", "\nSP=", "\nELR=", "\nESR=", "\nFAR=",
+        "\nPHYS=", "\nIMAGE=", "\nTOTAL=", "\nDROPPED="};
+    const uint64_t values[] = {capture->caller, capture->sp, capture->elr, capture->esr,
+        capture->far, capture->physical_base, capture->image_va, capture->total, capture->dropped};
+    for (unsigned i = 0; i < sizeof(values) / sizeof(values[0]); i++) {
+        sheng_qr_append(&used, keys[i]);
+        sheng_qr_hex(&used, values[i], 16);
+    }
+    sheng_qr_append(&used, "\nREGS=panic-hook\nREASON=");
+    unsigned n = 0;
+    for (; reason && reason[n] && n < SHENG_QR_REASON_MAX; n++) {
+        const unsigned char c = (unsigned char)reason[n];
+        char value[] = {(char)(c >= 32 && c <= 126 ? c : ' '), 0};
+        sheng_qr_append(&used, value);
+    }
+    sheng_qr_append(&used, reason && reason[n] ? "\nTRUNCATED=1" : "\nTRUNCATED=0");
+    sheng_qr_payload_bytes = used;
+    for (unsigned i = 0; i < used; i++) sheng_qr_scratch[i] = (uint8_t)sheng_qr_payload[i];
+    int success = qrcodegen_encodeBinary(sheng_qr_scratch, used, sheng_qr_modules,
+        qrcodegen_Ecc_MEDIUM, 1, SHENG_QR_VERSION_MAX, qrcodegen_Mask_AUTO, false);
+    __atomic_store_n(&sheng_qr_state, success ? 2 : 3, __ATOMIC_RELEASE);
+    return success;
+}
+
+/* Fit the QR and its four-module quiet zone inside the already mapped panic region. */
+static unsigned sheng_qr_extent(unsigned width, unsigned height, unsigned *scale)
+{
+    if (__atomic_load_n(&sheng_qr_state, __ATOMIC_ACQUIRE) != 2) return 0;
+    unsigned modules = (unsigned)qrcodegen_getSize(sheng_qr_modules) + 8;
+    unsigned limit = height < width / 2 ? height : width / 2;
+    *scale = limit / modules;
+    if (*scale > 6) *scale = 6;
+    return *scale >= 2 ? modules * *scale : 0;
+}
+static void sheng_qr_draw(uintptr_t base, unsigned stride, unsigned width, unsigned height)
+{
+    unsigned scale = 0, extent = sheng_qr_extent(width, height, &scale);
+    if (!extent) return;
+    unsigned size = (unsigned)qrcodegen_getSize(sheng_qr_modules);
+    for (unsigned y = 0; y < extent; y++) {
+        volatile uint32_t *pixels = (volatile uint32_t *)(base + y * stride + (width - extent) * 4);
+        for (unsigned x = 0; x < extent; x++) {
+            unsigned mx = x / scale, my = y / scale;
+            int dark = mx >= 4 && my >= 4 && mx < size + 4 && my < size + 4 &&
+                qrcodegen_getModule(sheng_qr_modules, (int)mx - 4, (int)my - 4);
+            pixels[x] = dark ? 0xff000000u : 0xffffffffu;
+        }
+    }
+    __asm__ volatile("dsb sy" ::: "memory");
+}
+#endif
