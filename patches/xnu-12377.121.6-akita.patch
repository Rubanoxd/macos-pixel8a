+/* The Tensor PMU is secure: plain loads abort the bus. Linux and the UEFI go through the EL3 monitor
+ * (TENSOR_SMC_PMU_SEC_REG: x1 = register, x2 = 0 read / 1 write, x3 = value; the read value comes back in x0). */
+static uint64_t
+akita_pmu_smc(uint64_t reg, uint64_t op, uint64_t value)
+{
+	register uint64_t x0 __asm__("x0") = 0x82000504ULL;
+	register uint64_t x1 __asm__("x1") = reg;
+	register uint64_t x2 __asm__("x2") = op;
+	register uint64_t x3 __asm__("x3") = value;
+	__asm__ volatile ("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) :
+	    : "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+	return x0;
+}
+
+static int
+sysctl_akita_pmu_val SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	if ((akita_phys_addr & ~0xffffULL) != 0x15460000ULL) {
+		return EINVAL;
+	}
+	int value = (int)akita_pmu_smc(akita_phys_addr, 0, 0);
+	int error = sysctl_handle_int(oidp, &value, 0, req);
+	if (error || !req->newptr) {
+		return error;
+	}
+	uint64_t r = akita_pmu_smc(akita_phys_addr, 1, (uint32_t)value);
+	printf("AKITA PMU: smc write 0x%08x to 0x%llx -> 0x%llx\n", (uint32_t)value, akita_phys_addr, r);
+	return 0;
+}
+SYSCTL_PROC(_kern, OID_AUTO, akita_pmu_val, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, 0, 0,
+    sysctl_akita_pmu_val, "IU", "akita: secure-monitor read/write of the PMU register at akita_phys_addr");
+
+/* Straight to fastboot without the VFS shutdown (reboot -q from a full-OS session panics in vnode_rele_ext on the unions).
+ * A PSCI SYSTEM_RESET lands in Android recovery; a watchdog reset honours the PMU reboot command (0xFC, bootloader) the UEFI
+ * already set, so: reload the cluster-0 watchdog (s3c2410 layout at 0x10060000) with a count of 1 and let it fire. */
+static int
+sysctl_akita_fastboot SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int value = 0;
+	int error = sysctl_handle_int(oidp, &value, 0, req);
+	if (error || !req->newptr || value != 1) {
+		return error;
+	}
+	printf("AKITA: reset to fastboot through the watchdog\n");
+	akita_pmu_smc(0x15460810ULL, 1, 0xFC);
+	volatile uint32_t *wdt = (volatile uint32_t *)ml_io_map(0x10060000, 0x4000);
+	wdt[0] = 0;                                /* WTCON off */
+	wdt[1] = 1;                                /* WTDAT */
+	wdt[2] = 1;                                /* WTCNT */
+	__builtin_arm_dsb(0xf);
+	wdt[0] = (1u << 5) | (1u << 0);            /* enable, reset on expiry, prescaler 0, divider 16 */
+	__builtin_arm_dsb(0xf);
+	for (;;) {
+		__builtin_arm_wfe();
+	}
+}
+SYSCTL_PROC(_kern, OID_AUTO, akita_fastboot, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, 0, 0,
+    sysctl_akita_fastboot, "I", "akita: write 1 to reset straight into fastboot");
+
+/* The Mali-G715 driver (platform/akita/drivers/Mali, linked into the kernel): sysctl -w kern.akita_mali=N runs its bring-up to level N once. */
+extern void mali_start_level(unsigned on);
