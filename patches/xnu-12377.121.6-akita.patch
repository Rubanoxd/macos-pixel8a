+extern struct mach_header_64 _mh_execute_header;
+extern kern_return_t corecrypto_kext_start(kmod_info_t *, void *);
+SECURITY_READ_ONLY_LATE(kern_return_t) sheng_corecrypto_status = KERN_FAILURE;
+SECURITY_READ_ONLY_LATE(kmod_info_t *) sheng_native_crypto_kmod;
+static SECURITY_READ_ONLY_LATE(unsigned) sheng_native_crypto_state;
+extern vm_offset_t vm_kernel_slide;
+bool sheng_native_crypto_is_original(kmod_info_t *module);
+kern_return_t sheng_native_crypto_start_once(kmod_info_t *module, void *data);
