+static int
+akita_fullos_has_vfs(const char *name)
+{
+	struct vfstable *vfc;
+	mount_list_lock();
+	for (vfc = vfsconf; vfc; vfc = vfc->vfc_next) {
+		if (strncmp(vfc->vfc_name, name, MFSNAMELEN) == 0) {
+			mount_list_unlock();
+			return 1;
+		}
+	}
+	mount_list_unlock();
+	return 0;
+}
+
+static void
+akita_fullos_ensure_tmpfs(void)
+{
+	if (akita_fullos_has_vfs("tmpfs")) {
+		printf("AKITA FULLOS: tmpfs VFS already registered\n");
+		return;
+	}
+	printf("AKITA FULLOS: tmpfs VFS not registered, loading kext...\n");
+	kern_return_t kr = OSKextLoadKextWithIdentifier("com.apple.filesystems.tmpfs");
+	printf("AKITA FULLOS: OSKextLoadKextWithIdentifier(tmpfs) = %d\n", kr);
+	if (akita_fullos_has_vfs("tmpfs")) {
+		printf("AKITA FULLOS: tmpfs VFS now registered\n");
+	} else {
+		printf("AKITA FULLOS: tmpfs still NOT registered, listing VFS types:\n");
+		struct vfstable *vfc;
+		mount_list_lock();
+		for (vfc = vfsconf; vfc; vfc = vfc->vfc_next) {
+			printf("AKITA FULLOS:   vfs: %s (typenum %d)\n", vfc->vfc_name, vfc->vfc_typenum);
+		}
+		mount_list_unlock();
+	}
+}
+
+static int
+akita_fullos_mount(proc_t p, user_addr_t scratch, const char *type, const char *path, const void *data, size_t size,
+    int flags)
+{
+	struct mount_args request = {.type = scratch + 0xa00, .path = scratch + 0xa40, .flags = flags,
+		                     .data = scratch + 0xc00};
+	int32_t result = 0;
+	int error;
+	if ((error = copyout(type, request.type, strlen(type) + 1)) != 0 ||
+	    (error = copyout(path, request.path, strlen(path) + 1)) != 0 ||
+	    (error = copyout(data, request.data, size)) != 0) {
+		return error;
+	}
+	return mount(p, &request, &result);
+}
+
+static int
+akita_fullos_mkdir(proc_t p, user_addr_t scratch, const char *path)
+{
+	struct mkdir_args request = {.path = scratch + 0xa40, .mode = 0755};
+	int32_t result = 0;
+	int error = copyout(path, request.path, strlen(path) + 1);
+	if (error == 0) {
+		error = mkdir(p, &request, &result);
+	}
+	return error == EEXIST ? 0 : error;
+}
