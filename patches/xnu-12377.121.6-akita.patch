+	return 0;
+}
+SYSCTL_PROC(_kern, OID_AUTO, akita_mali, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, 0, 0,
+    sysctl_akita_mali, "I", "akita: run the Mali bring-up to this level");
