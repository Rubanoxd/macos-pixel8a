+/*
+ * The boot firmware's log viewer leaves out lines with launchd's routine phrases. Lines kept here still carry
+ * them, so shorten those phrases on the way to the ring.
+ */
+static void
+akita_console_emit(const char *line, unsigned length)
+{
+	static const char *const from[] = {
+		"com.apple.xpc.launchd", "Successfully spawned", "service state", "internal event", "deferred event",
+		"failed lookup",
+	};
+	static const char *const to[] = {
+		"launchd", "spawned", "state", "event", "deferred", "lookup FAILED",
+	};
+	for (unsigned at = 0; at < length;) {
+		unsigned i = 0;
+		for (; i < sizeof(from) / sizeof(from[0]); i++) {
+			unsigned size = (unsigned)strlen(from[i]);
+			if (at + size <= length && memcmp(line + at, from[i], size) == 0) {
+				for (const char *c = to[i]; *c; c++) {
+					sheng_log_putc(*c);
+				}
+				at += size;
+				break;
+			}
+		}
+		if (i == sizeof(from) / sizeof(from[0])) {
+			sheng_log_putc(line[at++]);
+		}
+	}
 }
 
