+			int autherr = VNOP_IOCTL(rootvnode, FSIOC_KERNEL_ROOTAUTH, NULL, 0, vfs_context_kernel());
+			printf("AKITA: root authentication %d (unsealed development root accepted)\n", autherr);
+			require_rootauth = FALSE;
+		}
+#endif
