+// The shadow of a surface: its pixels as last converted. A surface not seen before (or after its slot was reused) is fresh
+// and is copied whole.
+NativeGOPDisplay::Shadow *NativeGOPDisplay::shadowFor(IOSurface *surface, uint64_t bytes, bool *fresh)
+{
+    Shadow *victim = &fShadow[0];
+    for (auto &slot : fShadow) {
+        if (slot.surface == surface && slot.bytes == bytes) {
+            slot.used = ++fShadowUse;
+            *fresh = false;
+            return &slot;
+        }
+        if (slot.used < victim->used)
+            victim = &slot;
+    }
+    if (victim->bytes != bytes) {
+        if (victim->pixels)
+            IOFree(victim->pixels, victim->bytes);
+        victim->pixels = static_cast<uint32_t *>(IOMalloc(bytes));
+        victim->bytes = victim->pixels ? bytes : 0;
+    }
+    if (!victim->pixels)
+        return nullptr;
+    victim->surface = surface;
+    victim->used = ++fShadowUse;
+    *fresh = true;
+    return victim;
+}
