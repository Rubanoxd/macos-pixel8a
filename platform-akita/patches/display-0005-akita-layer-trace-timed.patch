--- a/NativeGOPDisplay.cpp
+++ b/NativeGOPDisplay.cpp
@@ -356,6 +356,22 @@
 
 // Copy the compatible scene before completing the swap. Cursor-only updates
 // leave scanout intact; no separate hardware cursor plane is advertised.
+// akita bring-up: native-gop-layer-trace-after=<s> holds the layer trace back until that much uptime (a scripted
+// menu or cursor test), so its lines land at the end of the retained log.
+#include <kern/clock.h>
+static bool layerTraceOpen()
+{
+    static unsigned after = ~0u;
+    if (after == ~0u) {
+        unsigned value = 0;
+        PE_parse_boot_argn("native-gop-layer-trace-after", &value, sizeof(value));
+        after = value;
+    }
+    uint64_t now;
+    absolutetime_to_nanoseconds(mach_absolute_time(), &now);
+    return now >= after * 1000000000ULL;
+}
+
 void NativeGOPDisplay::program_hardware_gated()
 {
     IOMFBSwapIORequest *swap = at<IOMFBSwapIORequest *>(this, kCurrentSwap);
@@ -380,7 +396,7 @@
