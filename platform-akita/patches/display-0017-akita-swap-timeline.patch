+#include <libkern/OSAtomic.h>
+void NativeGOPDisplay::timelineMark(char kind)
+{
+    uint64_t us = 0;
+    absolutetime_to_nanoseconds(mach_absolute_time(), &us);
+    us /= 1000;
+    const uint32_t slot = static_cast<uint32_t>(OSIncrementAtomic(reinterpret_cast<volatile SInt32 *>(&fTimelineNext))) % kTimelineCap;
+    fTimeline[slot] = (static_cast<uint32_t>(us) & 0x00ffffffu) | (static_cast<uint32_t>(static_cast<uint8_t>(kind)) << 24);
+}
+
+void NativeGOPDisplay::timelineDump()
+{
+    const uint32_t end = fTimelineNext;
+    const uint32_t count = end < kTimelineCap ? end : kTimelineCap;
+    uint32_t base = fTimeline[(end - count) % kTimelineCap] & 0x00ffffffu;
+    char line[200];
+    unsigned used = 0;
+    for (uint32_t i = 0; i < count; i++) {
+        const uint32_t e = fTimeline[(end - count + i) % kTimelineCap];
+        const uint32_t t = ((e & 0x00ffffffu) - base) & 0x00ffffffu;
+        used += snprintf(line + used, sizeof line - used, " %c%u", static_cast<char>(e >> 24), t / 100);
+        if (used > 150 || i + 1 == count) {
+            IOLog("NativeGOPDisplay: timeline%s\n", line);
+            used = 0;
+        }
+    }
+}
