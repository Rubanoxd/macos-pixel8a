+IOReturn NativeGOPDisplay::setProperties(OSObject *properties)
+{
+    OSDictionary *dict = OSDynamicCast(OSDictionary, properties);
+    if (dict && brightnessLogOK()) {
+        OSCollectionIterator *it = OSCollectionIterator::withCollection(dict);
+        char line[256] = "";
+        size_t used = 0;
+        while (it) {
+            const OSSymbol *key = OSDynamicCast(OSSymbol, it->getNextObject());
+            if (!key)
+                break;
+            OSNumber *num = OSDynamicCast(OSNumber, dict->getObject(key));
+            const int w = num ? snprintf(line + used, sizeof(line) - used, " %s=%llu", key->getCStringNoCopy(), num->unsigned64BitValue())
+                              : snprintf(line + used, sizeof(line) - used, " %s", key->getCStringNoCopy());
+            if (w <= 0 || used + static_cast<size_t>(w) >= sizeof(line))
+                break;
+            used += static_cast<size_t>(w);
+        }
+        if (it)
+            it->release();
+        IOLog("NativeGOPDisplay: setProperties%s\n", line);
+    }
+    return IOMobileFramebufferLegacy::setProperties(properties);
+}
