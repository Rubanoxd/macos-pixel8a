+// akita (Generated-by: LLM): what corebrightnessd asks the framebuffer for, so the panel brightness (AkitaBacklight.inc in the
+// kernel, DCS 0x51 over DSIM0) can follow macOS's own brightness. This first step only logs the calls and passes them on.
+static unsigned gBrightnessLog;
+static bool brightnessLogOK() { return gBrightnessLog++ < 300; }
+
+IOReturn NativeGOPDisplay::set_parameter(IOMFBParameterName name, unsigned long long const *values, unsigned int count)
+{
+    if (brightnessLogOK())
+        IOLog("NativeGOPDisplay: set_parameter %u count %u values %llu %llu %llu\n", static_cast<unsigned>(name), count,
+              values && count > 0 ? values[0] : 0ULL, values && count > 1 ? values[1] : 0ULL, values && count > 2 ? values[2] : 0ULL);
+    return IOMobileFramebufferLegacy::set_parameter(name, values, count);
+}
